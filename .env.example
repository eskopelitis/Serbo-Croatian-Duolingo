# Copy this file to .env and fill in what you need. Everything is optional.

# AI tutor, writing help and word extraction. Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Backup AI: a local LM Studio server running openai/gpt-oss-20b.
# Used when DeepSeek fails or no key is set.
# LOCAL_LLM_URL=http://127.0.0.1:1234/v1

# Web access. Default serves this computer and phones on the same Wi-Fi.
# Set SONGTOLEARN_HOST=127.0.0.1 to allow only this computer.
# SONGTOLEARN_HOST=0.0.0.0
# SONGTOLEARN_PORT=5000

# Serbian voice (Piper "Marko"). Install with: python tools/setup_sc_voice.py
# Override only if the files live somewhere else:
# SC_PIPER_MODEL=C:/path/to/sr_Marko_medium.onnx
# SC_PIPER_CONFIG=C:/path/to/sr_Marko_medium.onnx.json

# Optional speech recognition for Talk (CrispASR whisper server).
# Defaults look in Documents/CrispASR.
# CRISPASR_DIR=C:/path/to/CrispASR
# CRISPASR_EXE=C:/path/to/crispasr.exe
# STT_MODEL=C:/path/to/ggml-large-v3-turbo-q5_0.bin
STT_PORT=5091
